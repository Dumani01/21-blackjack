    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst player = String(body.player ?? '').trim();\nconst outcome = String(body.outcome ?? '').trim().toUpperCase();\nconst score = Number(body.score ?? 0);\n\nif (!player) {\n  throw new Error('El nombre del jugador es obligatorio');\n}\n\nif (!['BLACKJACK', 'WIN', 'PUSH', 'LOSE', 'BUST'].includes(outcome)) {\n  throw new Error('Resultado no válido');\n}\n\nreturn [{\n  json: {\n    player,\n    outcome,\n    score,\n    playerTotal: Number(body.playerTotal ?? 0),\n    dealerTotal: Number(body.dealerTotal ?? 0),\n    roundId: body.roundId ?? `round-${Date.now()}`,\n    createdAt: body.createdAt ?? new Date().toISOString()\n  }\n}];"
      },
